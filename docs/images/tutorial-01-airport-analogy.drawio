1" parent="1" source="c4" target="c5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="provides the rules" style="html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;fontColor=#111111;whiteSpace=nowrap;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;fontSize=13;strokeColor=#5C5C5C;fontColor=#5C5C5C;labelBackgroundColor=#FFFFFF;edgeStyle=none;dashed=1;dashPattern=2 4;" edge="1" parent="1" source="c6" target="c5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="provides history" style="html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;fontColor=#111111;whiteSpace=nowrap;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;fontSize=13;strokeColor=#5C5C5C;fontColor=#5C5C5C;labelBackgroundColor=#FFFFFF;edgeStyle=none;dashed=1;dashPattern=2 4;" edge="1" parent="1" source="c7" target="c5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="asks for a prediction" style="html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;fontColor=#111111;whiteSpace=nowrap;endArrow=block;endFill=1;endSize=7;strokeWidth=1.5;fontSize=13;strokeColor=#5C5C5C;fontColor=#5C5C5C;labelBackgroundColor=#FFFFFF;edgeStyle=none;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c8" target="c5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="do travellers still&lt;br&gt;look like the manual?" style="html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;fontColor=#111111;whiteSpace=nowrap;endArrow=block;endFill=1;endSize=7;strok