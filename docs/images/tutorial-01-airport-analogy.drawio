<mxfile host="drawio" type="device"><diagram name="Step 1 - the airport analogy" id="tutorial-01-airport-analogy.drawio"><mxGraphModel grid="1" gridSize="10" guides="1" page="1" pageWidth="1300" pageHeight="520" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="The airport analogy — a security checkpoint for money" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;fontColor=#111111;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Passenger pays&lt;br&gt;'The Traveller'" style="html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;fontColor=#111111;rounded=0;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="230" height="64" as="geometry"/></mxCell><mxCell id="c3" value="Kafka&lt;br&gt;'The Security Queue'" style="html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;fontColor=#111111;rounded=0;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="230" height="64" as="geometry"/></mxCell><mxCell id="c4" value="Fraud consumer&lt;br&gt;'The Supervisor'" style="html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;fontColor=#111111;rounded=0;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="730" y="80" width="230" height="64" as="geometry"/></mxCell><mxCell id="c5" value="Scoring API&lt;br&gt;'The Security Officer'" style="html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;fontColor=#111111;rounded=0;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="730" y="260" width="230" height="64" as="geometry"/></mxCell><mxCell id="c6" value="MLflow @champion&lt;br&gt;'The Security Manual'" style="html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;fontColor=#111111;rounded=0;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="380" y="210" width="230" height="64" as="geometry"/></mxCell><mxCell id="c7" value="Feast / Redis&lt;br&gt;'The Traveller's File'" style="html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;fontColor=#111111;rounded=0;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="380" y="320" width="230" height="64" as="geometry"/></mxCell><mxCell id="c8" value="Airport app / analyst" style="html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;fontColor=#111111;rounded=0;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="400" y="440" width="190" height="50" as="geometry"/></mxCell><mxCell id="c9" value="Evidently&lt;br&gt;'The Auditor'" style="html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3A300%2C400%2C500%2C600;fontColor=#111111;rounded=0;fillCol